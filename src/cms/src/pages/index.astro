---
import SiteShell from "../layouts/SiteShell.astro";
import { HOME_DESCRIPTION, HOME_H1, HOME_TITLE, loadSite } from "../lib/site";

const site = loadSite();
const facts = site.slices.slice(0, 4);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Prism",
};
---

<SiteShell
  page="home"
  path="/"
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  vintageId={site.vintage_id}
  jsonLd={jsonLd}
>
  <h1>{HOME_H1}</h1>
  {facts.length > 0 && (
    <ul class="fast-facts">
      {facts.map((slice) => (
        <li>
          <a href={slice.path}>{slice.fact_lede}</a>
        </li>
      ))}
    </ul>
  )}
  {site.slices.length > 0 && (
    <nav class="hottest-rail" aria-label="Featured questions">
      {site.slices.map((slice) => (
        <a href={slice.path}>{slice.citizen_question}</a>
      ))}
    </nav>
  )}
  <ul class="sleeve-index">
    {site.sleeves.map((sleeve) => (
      <li>
        <a href={sleeve.path}>{sleeve.hub_label}</a>
      </li>
    ))}
  </ul>
</SiteShell>
