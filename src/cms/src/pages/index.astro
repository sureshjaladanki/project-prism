---
import { readFileSync } from "node:fs";
import path from "node:path";
import PortraitPage from "../layouts/PortraitPage.astro";
import { specToSvg } from "../lib/render-chart";

const boundDir = process.env.PRISM_BOUND_DIR;
if (!boundDir) {
  throw new Error("PRISM_BOUND_DIR is required");
}

type BoundFile = {
  template_id: string;
  vintage_id: string;
  charts: Record<string, unknown>;
};

const bound = JSON.parse(
  readFileSync(path.join(boundDir, "bound.json"), "utf8"),
) as BoundFile;
let body = readFileSync(path.join(boundDir, "body.html"), "utf8");
for (const [chartId, spec] of Object.entries(bound.charts)) {
  const svg = await specToSvg(spec);
  const figure = `<figure class="chart" id="chart-${chartId}">${svg}</figure>`;
  body = body.replaceAll(`<!--chart:${chartId}-->`, figure);
}
if (body.includes("<!--chart:")) {
  throw new Error("unbound chart placeholder remained after render");
}
---

<PortraitPage templateId={bound.template_id} vintageId={bound.vintage_id}>
  <article class="portrait" set:html={body} />
</PortraitPage>
