---
import SiteShell from "../layouts/SiteShell.astro";
import { HOME_DESCRIPTION, HOME_H1, HOME_TITLE, loadSite } from "../lib/site";

const site = loadSite();
const facts = site.slices.slice(0, 4);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Prism",
};
---

<SiteShell
  page="home"
  path="/"
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  vintageId={site.vintage_id}
  jsonLd={jsonLd}
>
  <h1>{HOME_H1}</h1>
  {facts.length > 0 && (
    <ul class="fast-facts">
      {facts.map((slice) => (
        <li>
          <a href={slice.path}>{slice.citizen_question}</a>
          <p class="byline">{slice.fact_lede}</p>
        </li>
      ))}
    </ul>
  )}
</SiteShell>
