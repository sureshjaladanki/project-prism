{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "All India CPI General year-on-year inflation (%), Rural / Urban / Combined, latest Provisional. Combined is published, not a merge. Sector order is documented, not sorted by the measure.",
  "title": {
    "text": "All India year-on-year inflation (%)",
    "subtitle": "Rural, Urban and Combined. Combined is published, not made here."
  },
  "usermeta": {
    "slot_id": "chart-all-india-sectors-inflation-latest-p",
    "cite_in_same_view": true,
    "forbidden": ["sort_by_measure", "red_green_diverging", "homemade_combined"]
  },
  "height": { "step": 22 },
  "data": { "name": "slot:chart-all-india-sectors-inflation-latest-p" },
  "transform": [
    {
      "calculate": "datum.status === 'value' ? datum.value : null",
      "as": "plotValue"
    }
  ],
  "mark": { "type": "bar", "color": "#1f4e79", "invalid": "break-paths" },
  "encoding": {
    "y": {
      "field": "sector",
      "type": "nominal",
      "title": "Sector",
      "sort": ["Rural", "Urban", "Combined"]
    },
    "x": {
      "field": "plotValue",
      "type": "quantitative",
      "title": "Year-on-year inflation (%)",
      "scale": { "zero": true }
    },
    "tooltip": [
      { "field": "sector", "type": "nominal" },
      { "field": "plotValue", "type": "quantitative", "title": "inflation (%)" },
      { "field": "reference_period", "type": "nominal" },
      { "field": "status", "type": "nominal" }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": { "grid": true }
  }
}
