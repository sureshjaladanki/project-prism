{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Consumer Food Price Index beside Food and beverages. Two official numbers. Do not label Food and beverages as food. Same colour for both bars.",
  "title": {
    "text": "Food beside Food and beverages, All India Combined",
    "subtitle": "Same month. Two official numbers."
  },
  "usermeta": {
    "slot_id": "chart-cfpi-beside-division-01",
    "cite_in_same_view": true,
    "forbidden": ["label_div01_as_food", "sort_by_measure", "red_green_diverging", "pick_winner"]
  },
  "height": { "step": 22 },
  "data": { "name": "slot:chart-cfpi-beside-division-01" },
  "transform": [
    {
      "calculate": "datum.status === 'value' ? datum.value : null",
      "as": "plotValue"
    }
  ],
  "mark": { "type": "bar", "color": "#1f4e79", "invalid": "break-paths" },
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "sort": ["Consumer Food Price Index", "Food and beverages"],
      "axis": { "labelLimit": 400 }
    },
    "x": {
      "field": "plotValue",
      "type": "quantitative",
      "title": "Year-on-year inflation (%)",
      "scale": { "zero": true }
    },
    "tooltip": [
      { "field": "label", "type": "nominal" },
      { "field": "plotValue", "type": "quantitative", "title": "inflation (%)" },
      { "field": "unit", "type": "nominal" },
      { "field": "reference_period", "type": "nominal" },
      { "field": "status", "type": "nominal" }
    ]
  },
  "config": {
    "view": { "stroke": null }
  }
}
