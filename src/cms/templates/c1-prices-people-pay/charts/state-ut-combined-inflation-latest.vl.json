{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "State/UT Combined CPI General year-on-year inflation (%). Rank order by the published rate — this chart's caption asks where prices are rising fastest. Single fill — not red–green. All India is not on this axis. Unknown is not published, not zero.",
  "title": {
    "text": "Where are prices rising fastest?",
    "subtitle": "CPI (General) Combined year-on-year inflation (%), States and Union Territories"
  },
  "usermeta": {
    "slot_id": "chart-state-ut-combined-inflation-latest-p",
    "cite_in_same_view": true,
    "rank_caption": true,
    "axis_order": "measure_descending",
    "forbidden": ["red_green_diverging", "all_india_on_this_axis", "blank_as_zero"]
  },
  "height": { "step": 22 },
  "data": { "name": "slot:chart-state-ut-combined-inflation-latest-p" },
  "transform": [
    {
      "calculate": "datum.status === 'value' ? datum.value : null",
      "as": "plotValue"
    }
  ],
  "mark": { "type": "bar", "color": "#1f4e79", "invalid": "break-paths" },
  "encoding": {
    "y": {
      "field": "geography_name_en",
      "type": "nominal",
      "title": "State / Union Territory",
      "sort": { "field": "plotValue", "order": "descending" },
      "axis": { "labelLimit": 280 }
    },
    "x": {
      "field": "plotValue",
      "type": "quantitative",
      "title": "Year-on-year inflation (%)",
      "scale": { "zero": true }
    },
    "tooltip": [
      { "field": "geography_name_en", "type": "nominal" },
      { "field": "plotValue", "type": "quantitative", "title": "inflation (%)" },
      { "field": "sector", "type": "nominal" },
      { "field": "reference_period", "type": "nominal" },
      { "field": "status", "type": "nominal" }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": { "grid": true }
  }
}
