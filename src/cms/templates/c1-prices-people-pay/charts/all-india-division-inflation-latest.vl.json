{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "All India Combined CPI year-on-year inflation (%) by published group of the basket, latest Provisional. Producer annex order (codes 01–11, then 13). Not ranked. Food and beverages is not the Consumer Food Price Index. Single fill. No Division 12. Unknown is not published, not zero.",
  "title": {
    "text": "Retail basket groups, All India Combined",
    "subtitle": "Same month. Order as printed."
  },
  "usermeta": {
    "slot_id": "chart-division-inflation-latest-p",
    "cite_in_same_view": true,
    "axis_order": "producer_annex_division_codes",
    "forbidden": ["label_div01_as_food", "sort_by_measure", "red_green_diverging", "invent_div12", "rank"]
  },
  "height": { "step": 22 },
  "data": { "name": "slot:chart-division-inflation-latest-p" },
  "transform": [
    {
      "calculate": "datum.status === 'value' ? datum.value : null",
      "as": "plotValue"
    }
  ],
  "mark": { "type": "bar", "color": "#1f4e79", "invalid": "break-paths" },
  "encoding": {
    "y": {
      "field": "division_name",
      "type": "nominal",
      "title": null,
      "sort": [
        "Food and beverages",
        "Paan, tobacco and intoxicants",
        "Clothing and footwear",
        "Housing, water, electricity, gas and other fuels",
        "Furnishings, household equipment and routine household maintenance",
        "Health",
        "Transport",
        "Information and communication",
        "Recreation, sport and culture",
        "Education services",
        "Restaurants and accommodation services",
        "Personal care, social protection and miscellaneous goods and services"
      ],
      "axis": { "labelLimit": 320 }
    },
    "x": {
      "field": "plotValue",
      "type": "quantitative",
      "title": "Year-on-year inflation (%)",
      "scale": { "zero": true }
    },
    "tooltip": [
      { "field": "division_name", "type": "nominal" },
      { "field": "plotValue", "type": "quantitative", "title": "inflation (%)" },
      { "field": "status", "type": "nominal" },
      { "field": "reference_period", "type": "nominal" }
    ]
  },
  "config": {
    "view": { "stroke": null },
    "axis": { "grid": true }
  }
}
