{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Census 2011 India persons, Rural / Urban / Total. Three published lines. Same colour. Do not sort by the count. Not a 2026 headcount.",
  "title": {
    "text": "Census 2011, India, persons",
    "subtitle": "1 March 2011. Rural, Urban, and Total as published."
  },
  "usermeta": {
    "slot_id": "chart-india-residence-2011",
    "cite_in_same_view": true,
    "forbidden": ["sort_by_measure", "red_green_diverging", "treat_as_current", "blend_with_srs"]
  },
  "height": { "step": 22 },
  "data": { "name": "slot:chart-india-residence-2011" },
  "transform": [
    {
      "calculate": "datum.status === 'value' ? datum.value : null",
      "as": "plotValue"
    }
  ],
  "mark": { "type": "bar", "color": "#1f4e79", "invalid": "break-paths" },
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "sort": ["Rural", "Urban", "Total"],
      "axis": { "labelLimit": 400 }
    },
    "x": {
      "field": "plotValue",
      "type": "quantitative",
      "title": "Persons",
      "scale": { "zero": true }
    },
    "tooltip": [
      { "field": "label", "type": "nominal" },
      { "field": "plotValue", "type": "quantitative", "title": "persons" },
      { "field": "reference_period", "type": "nominal" },
      { "field": "status", "type": "nominal" }
    ]
  },
  "config": {
    "view": { "stroke": null }
  }
}
